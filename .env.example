# Supabase — VITE_ vars are bundled into the client, that's expected: the anon
# key is designed to be public and is safe as long as Row Level Security (see
# supabase/schema.sql) restricts writes to admins. SUPABASE_SECRET_KEY must
# NEVER be prefixed with VITE_ — this app has no backend, so it isn't used
# anywhere; keep it here only for future server-side tooling.
VITE_SUPABASE_URL=https://lsjtglurylyrbnlkszwg.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Cloudinary — cloud name + unsigned upload preset are safe to expose client
# side (that's how unsigned uploads work by design). CLOUDINARY_API_SECRET
# must NEVER be prefixed with VITE_ for the same reason as above.
VITE_CLOUDINARY_CLOUD_NAME=bttoiwjr
VITE_CLOUDINARY_UPLOAD_PRESET=aalaya_vastra
VITE_CLOUDINARY_API_KEY=939768171556227
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://939768171556227:your_cloudinary_api_secret@bttoiwjr

# Razorpay Payment Gateway — VITE_RAZORPAY_KEY_ID is public for the client checkout
# modal. RAZORPAY_KEY_SECRET must NEVER have a VITE_ prefix.
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
